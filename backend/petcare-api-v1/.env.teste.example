# Ambiente de TESTE LOCAL do PetCare Connect. Copie para .env.teste (nunca commitar) e preencha.
# Use com: npm run teste:verificar | npm run teste:api   (node --env-file=.env.teste ...)
# Todas as variáveis do .env.example estão aqui, para nada vir do .env de produção.
PETCARE_AMBIENTE=teste

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL local (database/teste/docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=petcare_teste
DB_PASSWORD=mesma_senha_de_MYSQL_PASSWORD_em_database_teste_env
DB_NAME=petcare_teste
# Certificado gerado pelo docker-compose (caminho a partir de backend/petcare-api-v1)
DB_SSL_CA_PATH=../../database/teste/certificados/ca.pem
DB_CONNECTION_LIMIT=5

# Gere uma chave só para o teste: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere_uma_chave_longa_e_aleatoria_so_para_o_teste

# SMTP de teste (ex.: Mailtrap/Ethereal). Não use o SMTP de produção: e-mails reais não podem sair do teste.
SMTP_HOST=smtp.seu-provedor-de-teste.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp_de_teste
SMTP_PASS=senha_smtp_de_teste
MAIL_FROM="PetCare Connect (teste) <nao-responda@teste.local>"
APP_URL=http://localhost:5173

# Cloudflare R2: bucket de TESTE (a trava dos scripts exige o final "-teste")
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=chave_com_acesso_so_ao_bucket_de_teste
R2_SECRET_ACCESS_KEY=segredo_da_chave_do_bucket_de_teste
R2_BUCKET_NAME=petcare-media-teste
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://url-publica-do-bucket-de-teste

# Mercado Pago: só credenciais de TESTE (TEST-...)
MP_ACCESS_TOKEN=seu_access_token_de_teste
MP_WEBHOOK_URL=http://localhost:3000/pagamentos/webhook
# MP_WEBHOOK_SECRET=segredo_do_webhook_de_teste
