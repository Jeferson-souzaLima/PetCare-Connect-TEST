# Server
PORT=3000
# Só no ambiente de teste local (.env.teste): PETCARE_AMBIENTE=teste libera os scripts de teste.
# PETCARE_AMBIENTE=
# Separe por vírgulas se precisar liberar mais de uma origem.
CORS_ORIGIN=http://localhost:5173
# No Render, defina CORS_ORIGIN=https://mvp-beige-sigma.vercel.app

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_uma_senha_segura
DB_NAME=petcare
# Opcional: o padrão é ca.pem no diretório da API.
# DB_SSL_CA_PATH=/caminho/para/ca.pem
# DB_CONNECTION_LIMIT=10

# Use a long, unique, random value in each environment.
# Mínimo de 32 caracteres (a API não inicia com menos). Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=gere_uma_chave_longa_e_aleatoria

# SMTP para confirmação de e-mail
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_ou_app_password_smtp
MAIL_FROM="PetCare Connect <nao-responda@seu-dominio.com>"
APP_URL=http://localhost:5173

# Cloudflare R2 (armazenamento das imagens de produtos/lojas)
# Todas são obrigatórias para upload; sem elas o upload falha com R2_CONFIG_MISSING.
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key_id
R2_SECRET_ACCESS_KEY=sua_secret_access_key
R2_BUCKET_NAME=nome-do-bucket
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# URL pública usada para montar o endereço das imagens (domínio do bucket ou r2.dev)
R2_PUBLIC_URL=https://seu-dominio-publico-do-bucket

# Mercado Pago (necessário para os fluxos de pagamento)
MP_ACCESS_TOKEN=seu_access_token
# Opcional conforme a configuração do webhook
MP_WEBHOOK_URL=https://seu-dominio.com/pagamentos/webhook
# MP_WEBHOOK_SECRET=seu_segredo_do_webhook

# Mercado Pago – conexão da conta do lojista (OAuth, split de pagamento)
# Client ID e Client Secret ficam em "Credenciais de produção" da aplicação.
MP_CLIENT_ID=seu_client_id
MP_CLIENT_SECRET=seu_client_secret
# Precisa ser idêntica à URL de redirecionamento cadastrada na aplicação.
MP_OAUTH_REDIRECT_URI=https://sua-api.com/mercadopago/oauth/retorno
# Chave que criptografa os tokens das lojas: 32 bytes em base64, diferente em cada ambiente.
# Se for perdida, os lojistas precisam reconectar. Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_TOKEN_KEY=gere_uma_chave_de_32_bytes_em_base64
